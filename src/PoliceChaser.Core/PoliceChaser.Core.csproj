<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-android36.0;net10.0-ios</TargetFrameworks>
    <RootNamespace>PoliceChaser</RootNamespace>
    <AssemblyName>PoliceChaser.Core</AssemblyName>
    <OutputType>Library</OutputType>
    <IsTrimmable>false</IsTrimmable>
    <ApplicationIdGuid>a6eaeb04-6634-41c1-bdfe-695819ece444</ApplicationIdGuid>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="$(MonoGameVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android36.0'">
    <PackageReference Include="MonoGame.Framework.Android" Version="$(MonoGameVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
    <PackageReference Include="MonoGame.Framework.iOS" Version="$(MonoGameVersion)" />
  </ItemGroup>

</Project>
