<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>18.0</SupportedOSPlatformVersion>
    <RootNamespace>PoliceChaser.iOS</RootNamespace>
    <AssemblyName>PoliceChaser</AssemblyName>
    <ApplicationTitle>Police Chaser</ApplicationTitle>
    <ApplicationVersion>3</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.1</ApplicationDisplayVersion>
    <CodesignKey>Apple Development</CodesignKey>
    <CodesignProvision>devel-police</CodesignProvision>
    <MtouchLink>SdkOnly</MtouchLink>
    <!-- Tells actool which asset catalog is the app icon, so it generates every
         device size and writes CFBundleIconName into the Info.plist. -->
    <AppIcon>AppIcon</AppIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.iOS" Version="$(MonoGameVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PoliceChaser.Core\PoliceChaser.Core.csproj"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
  </ItemGroup>

  <ItemGroup>
    <BundleResource Include="Icons\*.png" />
  </ItemGroup>

</Project>
