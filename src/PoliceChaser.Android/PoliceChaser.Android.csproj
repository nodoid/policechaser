<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <SupportedOSPlatformVersion>32.0</SupportedOSPlatformVersion>
    <TargetSdkVersion>36</TargetSdkVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>PoliceChaser.Android</RootNamespace>
    <AssemblyName>PoliceChaser.Android</AssemblyName>
    <ApplicationId>uk.co.allthejohnsons.policechaser</ApplicationId>
    <ApplicationVersion>2</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.1</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.Android" Version="$(MonoGameVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PoliceChaser.Core\PoliceChaser.Core.csproj"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
  </ItemGroup>

</Project>
