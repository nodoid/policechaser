<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Android 12+ draws the system splash screen from these attributes. -->
  <style name="PoliceChaserTheme" parent="@android:style/Theme.NoTitleBar.Fullscreen">
    <item name="android:windowBackground">@drawable/splash</item>
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowFullscreen">true</item>
    <item name="android:windowActionBar">false</item>
    <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
    <item name="android:windowSplashScreenAnimatedIcon">@mipmap/icon</item>
    <item name="android:windowSplashScreenAnimationDuration">400</item>
  </style>
</resources>
